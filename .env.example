# Copy to .env (gitignored). Loaded by the app via pydantic-settings/python-dotenv;
# never sourced by the dev shell, so secrets stay out of subprocess environments.

# Visual module (Claude API). Opt-in per job; leave empty to disable (llm: disabled).
ANTHROPIC_API_KEY=
# Optional: raises the GitHub API anonymous rate limit (adsb.lol release discovery).
GITHUB_TOKEN=

# Optional contact appended to the Nominatim/Overpass User-Agent: "triangulate/0.1 (<contact>)".
TRIANGULATE_CONTACT=

# Knobs (defaults shown)
# TRIANGULATE_DATA=./data
# TRIANGULATE_LLM_BUDGET_USD=2.00
# TRIANGULATE_TRIAGE_MODEL=claude-haiku-5-5
# TRIANGULATE_CLUE_MODEL=claude-opus-5-5
# TRIANGULATE_BASEMAP_ENABLED=true
# TRIANGULATE_BASEMAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# TRIANGULATE_HOST=127.0.0.1
# TRIANGULATE_PORT=8000
# TRIANGULATE_RETENTION_DAYS=7
# TRIANGULATE_MAX_JOBS_PER_DAY=20
# TRIANGULATE_MAX_UPLOAD_BYTES=2000000000
# TRIANGULATE_SPEED_OF_SOUND=343.0
# TRIANGULATE_H_OBS_M=5.0
# TRIANGULATE_EXCLUDE_HELICOPTERS=false
